# Server-only credentials. Copy this file to .env.local (gitignored), then fill
# values locally from your dedicated Supabase project. Never add NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Canonical browser origin, checked for login/logout CSRF protection.
APP_ORIGIN=http://localhost:3000
