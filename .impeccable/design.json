  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary button as implemented in the learning workspace.",
      "html": "<button class=\"ds-control ds-primary\">Check answer</button>",
      "css": ".ds-primary{font-family:var(--sans, \"DM Sans\", sans-serif);font-size:12px;background:var(--green,#234d40);color:var(--on-action,#fffefa);border:1px solid var(--green,#234d40);border-radius:7px;padding:11px 16px;font-weight:500;cursor:pointer;transition:background .18s ease,color .18s ease;}.ds-control:hover:not(:disabled){filter:brightness(.96)}.ds-control:focus-visible{outline:2px solid var(--focus,#406b30);outline-offset:4px}.ds-control:disabled{opacity:.5;cursor:default}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Secondary button as implemented in the learning workspace.",
      "html": "<button class=\"ds-control ds-secondary\">Show hint</button>",
      "css": ".ds-secondary{font-family:var(--sans, \"DM Sans\", sans-serif);font-size:12px;background:transparent;color:var(--ink,#213b35);border:1px solid #bac7ac;border-radius:7px;padding:9px 13px;cursor:pointer;transition:background .18s ease,color .18s ease;}.ds-control:hover:not(:disabled){filter:brightness(.96)}.ds-control:focus-visible{outline:2px solid var(--focus,#406b30);outline-offset:4px}.ds-control:disabled{opacity:.5;cursor:default}"
    },
    {
      "name": "Text button",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Text button as implemented in the learning workspace.",
      "html": "<button class=\"ds-control ds-text\">Show solution</button>",
      "css": ".ds-text{font-family:var(--sans, \"DM Sans\", sans-serif);font-size:12px;background:transparent;border:0;color:var(--green,#234d40);padding:7px 0;cursor:pointer;transition:background .18s ease,color .18s ease;}.ds-control:hover:not(:disabled){filter:brightness(.96)}.ds-control:focus-visible{outline:2px solid var(--focus,#406b30);outline-offset:4px}.ds-control:disabled{opacity:.5;cursor:default}"
    },
    {
      "name": "Answer input",
      "kind": "input",
      "refersTo": "answer-input",
      "description": "Answer input as implemented in the learning workspace.",
      "html": "<label class=\"ds-label\">Your answer <input class=\"ds-control ds-input\" aria-label=\"Your answer\"></label>",
      "css": ".ds-label{font-family:var(--sans, \"DM Sans\", sans-serif);font-size:12px;color:var(--ink,#213b35)}.ds-input{font:15px/1.6 var(--sans,sans-serif);background:var(--surface,#fffefa);color:var(--ink,#213b35);border:1px solid #b8c4af;border-radius:7px;padding:10px 12px;caret-color:var(--green,#234d40)}.ds-control:hover:not(:disabled){filter:brightness(.96)}.ds-control:focus-visible{outline:2px solid var(--focus,#406b30);outline-offset:4px}.ds-control:disabled{opacity:.5;cursor:default}"
    },
    {
      "name": "Answer choice",
      "kind": "card",
      "refersTo": "choice",
      "description": "Answer choice as implemented in the learning workspace.",
      "html": "<label class=\"ds-choice\"><input class=\"ds-control\" type=\"radio\" name=\"ds-choice\"><code>int age = 16;</code></label>",
      "css": ".ds-choice{display:flex;align-items:center;gap:12px;border:1px solid var(--line,#dddfd4);padding:15px 17px;border-radius:8px;background:var(--surface,#fffefa);color:var(--ink,#213b35);cursor:pointer}.ds-choice code{font:13px ui-monospace,monospace}.ds-choice input{accent-color:var(--green,#234d40)}.ds-choice:has(input:checked){background:var(--chosen,#e7edda);border-color:var(--chosen-border,#7f9767)}.ds-control:hover:not(:disabled){filter:brightness(.96)}.ds-control:focus-visible{outline:2px solid var(--focus,#406b30);outline-offset:4px}.ds-control:disabled{opacity:.5;cursor:default}"
    },
    {
      "name": "Activity navigation",
      "kind": "nav",
      "description": "Activity navigation as implemented in the learning workspace.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Activities\"><button class=\"ds-control ds-active\" aria-current=\"step\">Learn</button><button class=\"ds-control\">Example</button><button class=\"ds-control\">Practice</button></nav>",
      "css": ".ds-nav{display:flex;gap:21px;border-bottom:1px solid var(--line,#dddfd4);overflow-x:auto}.ds-nav button{font-family:var(--sans, \"DM Sans\", sans-serif);font-size:12px;white-space:nowrap;border:0;border-bottom:2px solid transparent;background:transparent;padding:13px 1px 14px;color:var(--muted,#64736b);cursor:pointer}.ds-nav button.ds-active{color:var(--green,#234d40);border-bottom-color:var(--green,#234d40);font-weight:700}.ds-control:hover:not(:disabled){filter:brightness(.96)}.ds-control:focus-visible{outline:2px solid var(--focus,#406b30);outline-offset:4px}.ds-control:disabled{opacity:.5;cursor:default}"
    },
    {
      "name": "Code trace",
      "kind": "custom",
      "description": "Coordinated source, variable watch, output, and explanation. Watch prose follows the selected locale; Java identifiers and code tokens remain unchanged.",
      "html": "<section class=\"ds-code\"><div class=\"ds-file\">Main.java</div><pre><code>int age = 16;\nSystem.out.println(age);</code></pre><div class=\"ds-value\">age = 16</div><div class=\"ds-console\">Output<pre>16</pre></div></section>",
      "css": ".ds-code{background:var(--editor,#1d2c29);color:var(--code-text,#e2e6c5);border-radius:12px;overflow:hidden;box-shadow:0 12px 28px #20372812}.ds-file{font-family:var(--sans, \"DM Sans\", sans-serif);font-size:12px;padding:12px 17px;background:var(--code-header,#253630);border-bottom:1px solid #ffffff16;color:var(--code-header-ink,#c2cdbd)}.ds-code pre{font:12px/2.1 ui-monospace,monospace;padding:15px 18px;overflow-x:auto}.ds-value{font:11px ui-monospace,monospace;color:var(--lime,#d8e898);padding:7px 18px 19px}.ds-console{font-family:var(--sans, \"DM Sans\", sans-serif);font-size:12px;border-top:1px solid #ffffff16;background:var(--code-console,#192723);padding:16px 18px;color:var(--code-console-label,#a8b6a7)}.ds-console pre{padding:0;color:var(--code-console-text,#e1ebd2)}.ds-control:hover:not(:disabled){filter:brightness(.96)}.ds-control:focus-visible{outline:2px solid var(--focus,#406b30);outline-offset:4px}.ds-control:disabled{opacity:.5;cursor:default}"
    },
    {
      "name": "Topic picker",
      "kind": "input",
      "description": "In-unit topic selection beside endpoint-disabled previous/next controls; a quiet PDF-page reference follows.",
      "html": "<div class=\"ds-picker\"><label for=\"ds-topic\">Select topic</label><div class=\"ds-picker-controls\"><select id=\"ds-topic\"><option>1.1 \u00b7 Introduction to Algorithms</option><option>1.2 \u00b7 Variables</option></select><button disabled aria-label=\"Previous topic\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"m15 18-6-6 6-6\"/></svg></button><button aria-label=\"Next topic\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"m9 18 6-6-6-6\"/></svg></button></div></div>",
      "css": ".ds-picker{font-family:var(--sans,\"DM Sans\",sans-serif);color:var(--ink,#213b35);display:flex;align-items:center;gap:18px}.ds-picker label{font-size:11px;color:var(--muted,#64736b)}.ds-picker-controls{display:flex;gap:7px;flex:1;min-width:0}.ds-picker select{width:100%;min-width:0;flex:1;border:1px solid var(--control-border,#9da99c);background:var(--surface,#fffefa);color:inherit;border-radius:7px;padding:10px 12px;font:12px var(--sans,sans-serif);cursor:pointer}.ds-picker button{display:grid;place-items:center;flex-shrink:0;width:36px;border:1px solid var(--line,#dddfd4);background:transparent;border-radius:6px;color:inherit;cursor:pointer;transition:background .18s ease,color .18s ease}.ds-picker button:hover:not(:disabled){filter:brightness(.96)}.ds-picker select:focus-visible,.ds-picker button:focus-visible{outline:2px solid var(--focus,#406b30);outline-offset:4px}.ds-picker button:disabled{opacity:.5;cursor:default}"
    },
    {
      "name": "Access primary action",
      "kind": "button",
      "refersTo": "access-primary",
      "description": "Shared login and session retry action; larger than compact lesson actions.",
      "html": "<button class=\"ds-access ds-access-primary\">Sign in</button>",
      "css": ".ds-access-primary{font:500 15px/1.6 var(--sans,\"DM Sans\",sans-serif);background:var(--green,#234d40);color:var(--on-action,#fffefa);border:0;border-radius:7px;padding:12px 18px;min-height:48px;cursor:pointer;transition:background .18s ease,color .18s ease}.ds-access-primary:hover:not(:disabled){background:var(--action-hover,#193e32);filter:brightness(.96)}.ds-access-primary:disabled{opacity:.5;cursor:default}.ds-access:focus-visible{outline:2px solid var(--focus,#406b30);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-access-primary{transition:none}}"
    },
    {
      "name": "Access field",
      "kind": "input",
      "refersTo": "access-input",
      "description": "Readable credential input using the inherited paper and green stroke.",
      "html": "<label class=\"ds-access-label\" for=\"ds-access-email\">Email</label><input id=\"ds-access-email\" class=\"ds-access ds-access-input\" type=\"email\" autocomplete=\"username\">",
      "css": ".ds-access-label{display:block;font:500 15px/1.6 var(--sans,\"DM Sans\",sans-serif);color:var(--ink,#213b35);margin-bottom:9px}.ds-access-input{font:16px/1.6 var(--sans,\"DM Sans\",sans-serif);background:var(--surface,#fffefa);color:var(--ink,#213b35);border:1px solid var(--control-border,#9da99c);border-radius:7px;padding:12px;min-width:0;caret-color:var(--green,#234d40)}.ds-access:focus-visible{outline:2px solid var(--focus,#406b30);outline-offset:4px}"
    },
    {
      "name": "Teacher roster",
      "kind": "custom",
      "description": "Captioned, ruled student progress table on paper; identity and overall completion lead. A localized mobile hint describes the horizontally scrollable region. Access state is text, and completion records practice rather than grades.",
      "html": "<p class=\"ds-roster-hint\" id=\"ds-roster-hint\">Scroll horizontally to see all units and last activity.</p><div class=\"ds-roster-scroll\" tabindex=\"0\" role=\"region\" aria-label=\"Student progress\" aria-describedby=\"ds-roster-hint\"><table class=\"ds-roster\"><caption>Completed activities</caption><thead><tr><th scope=\"col\">Student</th><th scope=\"col\">Overall completion</th><th scope=\"col\">Account access</th></tr></thead><tbody><tr><th scope=\"row\"><strong>Test learner</strong><span class=\"ds-roster-meta\">student@example.test</span></th><td><strong>20%</strong><span class=\"ds-roster-meta\">53 / 265</span></td><td>Enabled</td></tr></tbody></table></div>",
      "css": ".ds-roster-scroll{overflow-x:auto;background:var(--paper,#f7f6f0);color:var(--ink,#213b35);scrollbar-color:var(--green,#234d40) var(--paper,#f7f6f0)}.ds-roster-scroll:focus-visible{outline:2px solid var(--focus,#406b30);outline-offset:4px}.ds-roster{border-collapse:collapse;width:100%;font:15px/1.6 var(--sans,\"DM Sans\",sans-serif);font-variant-numeric:tabular-nums}.ds-roster caption{text-align:start;color:var(--muted,#64736b);padding-bottom:14px}.ds-roster th,.ds-roster td{text-align:start;border-bottom:1px solid var(--line,#dddfd4);padding:18px 16px;vertical-align:top}.ds-roster th:first-child{padding-left:0}.ds-roster thead th{font-size:12px;font-weight:500;white-space:nowrap}.ds-roster tbody th{font-weight:400;min-width:200px;max-width:300px;overflow-wrap:anywhere}.ds-roster td{min-width:85px}.ds-roster-meta{display:block;color:var(--muted,#64736b);font-size:12px;margin-top:5px}.ds-roster-hint{display:none}@media(max-width:650px){.ds-roster-hint{display:block;margin-top:28px;color:var(--muted,#64736b);font:15px/1.6 var(--sans,\"DM Sans\",sans-serif);max-width:40ch}.ds-roster-scroll{margin-top:16px}.ds-roster tbody th{min-width:160px;max-width:180px}.ds-roster thead th{white-space:normal;min-width:110px}}"
    },
    {
      "name": "Appearance control",
      "kind": "button",
      "description": "Localized target-appearance action shared by login, workspace and teacher headers; preference persists and otherwise follows device appearance.",
      "html": "<button class=\"ds-theme\" type=\"button\" aria-label=\"Switch to dark mode\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.463.402.807a6.25 6.25 0 0 0 8.268 8.268c.344-.215.829-.004.803.397\"/></svg><span>Dark mode</span></button>",
      "css": ".ds-theme{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:8px 12px;border:1px solid var(--control-border,#9da99c);border-radius:7px;background:var(--surface,#fffefa);color:var(--ink,#213b35);font:15px/1.6 var(--sans,\"DM Sans\",sans-serif);cursor:pointer;transition:background .18s ease,color .18s ease}.ds-theme:hover{filter:brightness(.96)}.ds-theme:focus-visible{outline:2px solid var(--focus,#406b30);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-theme{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "Learning lab",
    "overview": "Warm paper and green ink frame a quiet learning lab, with navy surfaces and light gray and white accents for dark appearance. Serif headings establish the reading hierarchy; compact sans-serif controls keep topic selection and practice precise. A dark code surface gives source, values, and output their own material without turning the workspace into a dashboard.\n\nThis is a scan of the implemented interface, grounded in `src/app/globals.css`, the learning workspace, and the code panel. The managed-access extension also uses `src/app/auth.css` and the authentication components, retaining the same world. The teacher overview and account-saved progress extension are evidenced by `src/app/teacher.css`, `src/app/progress.css`, `teacher-overview.tsx`, and `use-progress.ts`. The persisted appearance and native-textarea indentation extension is evidenced by `theme.ts`, `theme-toggle.tsx`, `java-editor.tsx`, and `editor-indentation.ts`. The direction was code-first; there is no approved image comp. Directional vocabulary comes from the recorded learning-lab contract rather than a new identity workshop.",
    "keyCharacteristics": [
      "Warm paper with green ink in light appearance; navy with light gray and white accents in dark appearance",
      "Serif lesson hierarchy with compact sans-serif controls",
      "Ruled separation and restrained soft corners",
      "Coordinated source, variable, output, and explanation states"
    ],
    "rules": [
      {
        "name": "The Two Materials Rule",
        "body": "Use the themed reading canvas for explanation and the dark editor for code, output, and revealed solutions.",
        "section": "colors"
      },
      {
        "name": "The Semantic Appearance Rule",
        "body": "Bind shared controls and reading surfaces to their semantic CSS properties so foreground, background, border, and focus change together.",
        "section": "colors"
      },
      {
        "name": "The Reading Hierarchy Rule",
        "body": "Reserve Newsreader for headings and lesson numerals; use DM Sans for prose and controls, and monospace for source and values.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Separate ordinary sections with rules and space; reserve the diffuse shadow for the code panel.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the serif heading and sans-serif control relationship.",
      "Do pair selected state color with a border, numeral, weight, or text cue.",
      "Do preserve horizontal scrolling for activity tabs and code, and wrapping labels in the mobile unit grid.",
      "Do disable arrival animation and transitions for reduced motion.",
      "Do use semantic foreground, background, border, and focus properties together in both appearances.",
      "Do preserve native composition and Tab focus navigation in source editing."
    ],
    "donts": [
      "Don't turn every lesson section into an elevated card.",
      "Don't use the lime highlight as ordinary body text on paper.",
      "Don't clip bilingual labels or code to force a fixed layout."
    ]
  }
}
